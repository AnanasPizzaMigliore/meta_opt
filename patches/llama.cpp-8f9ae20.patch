+++ b/src/models/qwen35.cpp
@@ -30,6 +30,24 @@ void llama_model_qwen35::load_arch_hparams(llama_model_loader & ml) {
     }
 }
 
+// Task-vocabulary LM head. When the GGUF carries output_sub (rows of the output matrix for the
+// tokens a task can emit, plus one zero pad row) only those rows are multiplied; every other
+// token gets the pad row's bias (-inf). The result is scattered back to the full vocabulary with
+// get_rows, so samplers and speculative decoding see ordinary [n_vocab, n_out] logits.
+// Disable with LLAMA_FULL_VOCAB=1.
+static bool qwen35_use_lm_head_sub(const llama_model & model) {
+    static const bool off = getenv("LLAMA_FULL_VOCAB") && atoi(getenv("LLAMA_FULL_VOCAB")) != 0;
+    return model.output_sub && !off;
+}
+
+static ggml_tensor * qwen35_lm_head_sub(ggml_context * ctx0, const llama_model & model, ggml_tensor * cur) {
+    ggml_tensor * l = ggml_mul_mat(ctx0, model.output_sub, cur);   // [n_sub, n_out]
+    l = ggml_add(ctx0, l, model.output_sub_b);                      // pad row -> -inf
+    l = ggml_cont(ctx0, ggml_transpose(ctx0, l));                   // [n_out, n_sub]
+    l = ggml_get_rows(ctx0, l, model.output_sub_map);               // [n_out, n_vocab]
+    return ggml_cont(ctx0, ggml_transpose(ctx0, l));                // [n_vocab, n_out]
+}
+
