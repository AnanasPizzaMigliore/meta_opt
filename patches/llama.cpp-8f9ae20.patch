+    cur = qwen35_use_lm_head_sub(model) ? qwen35_lm_head_sub(ctx0, model, cur)
+                                        : build_lora_mm(model.output, cur, model.output_s);
 
     cb(cur, "result_output", -1);
     res->t_logits = cur;
